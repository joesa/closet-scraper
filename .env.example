# Comma-separated proxies (http://user:pass@host:port)
PROXY_URLS=

# Optional stable proxy gateway (recommended for recurring replacement providers)
# If set, this takes precedence over PROXY_URLS.
PROXY_GATEWAY_URL=

# Optional startup health checks for configured proxies
PROXY_HEALTHCHECK_ENABLED=true
PROXY_HEALTHCHECK_TIMEOUT_MS=2500
PROXY_HEALTHCHECK_MIN_HEALTHY=1

# Optional direct test URLs. When set, these override MAPS_KEYWORDS/TARGET_LOCATIONS.
# Example:
# START_URLS=https://www.google.com/maps/search/custom+closet+contractors+Clarksville+TN/
START_URLS=

# Set true to run scraper-only tests without posting to Instantly webhooks.
DISABLE_WEBHOOKS=false

# Comma-separated search seed dimensions
MAPS_KEYWORDS=custom closets,closet organizers,closet design
TARGET_LOCATIONS=Nashville TN,Franklin TN,Murfreesboro TN

# Crawl controls
MAX_REQUESTS_PER_CRAWL=500
MAX_RESULTS_PER_QUERY=120
MAX_CONCURRENCY=8
HEADLESS=true
EMAIL_DISCOVERY_MAX_PAGES=3
EMAIL_DISCOVERY_SECOND_PASS_PAGES=2
EMAIL_DISCOVERY_TIMEOUT_MS=15000
DECISION_MAKER_MAX_PAGES=6
EMAIL_CONFIDENCE_THRESHOLD=75
ENABLE_MX_CHECK=false
ENABLE_SMTP_CHECK=false
SMTP_TIMEOUT_MS=8000
SMTP_MIN_INTERVAL_MS=1500
SMTP_MAX_PROBES_PER_DOMAIN=3
DOMAIN_CACHE_ENABLED=true
DOMAIN_CACHE_FILE=storage/domain-email-cache.json
DOMAIN_CACHE_PATTERN_TTL_DAYS=90
DOMAIN_CACHE_VALIDATION_TTL_DAYS=14

# Instantly campaign inbound webhook URLs
INSTANTLY_PIPELINE_A_WEBHOOK_URL=
INSTANTLY_PIPELINE_B_WEBHOOK_URL=
# Recommended: point both to closet-dashboard receiver endpoint,
# e.g. https://<dashboard-domain>/api/instantly/scraper-webhook

# Optional webhook auth (if your webhook endpoint expects it)
WEBHOOK_AUTH_HEADER=Authorization
WEBHOOK_AUTH_TOKEN=
# WEBHOOK_AUTH_TOKEN should match closet-dashboard INSTANTLY_RECEIVER_AUTH_TOKEN.

# Batch size for webhook POSTs
WEBHOOK_BATCH_SIZE=50

# Optional remote control plane (dashboard-managed scraper config)
# If configured, scraper fetches startup config from this endpoint and merges
# it over local env defaults.
SCRAPER_CONTROL_PLANE_CONFIG_URL=
SCRAPER_CONTROL_PLANE_TOKEN=
SCRAPER_CONTROL_PLANE_TIMEOUT_MS=8000

# Optional: if Vercel Deployment Protection is enabled on production,
# set this to the Protection Bypass for Automation secret.
SCRAPER_VERCEL_BYPASS_SECRET=

# Optional run-status telemetry endpoint (defaults to same token as above).
SCRAPER_RUN_STATUS_URL=
SCRAPER_RUN_STATUS_TOKEN=

# Compliance / list hygiene controls for Instantly exports
SUPPRESSION_LIST_FILE=
SUPPRESSION_EMAILS=
SUPPRESSION_DOMAINS=
EXCLUDE_ROLE_EMAILS=true
ROLE_LOCAL_PARTS=
UNSUBSCRIBE_BASE_URL=
UNSUBSCRIBE_SECRET=change-me
